# ==============================================================================
# ComplyWise Environment Configuration Template
# ==============================================================================
# Copy this file to .env and adjust values for your local or cloud environment.
# Never commit .env with real secrets to version control.

# ------------------------------------------------------------------------------
# Core Django Settings
# ------------------------------------------------------------------------------
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
ENABLE_DJANGO_ADMIN=True
COMPLYWISE_VERSION=0.1.0-foundation

# ------------------------------------------------------------------------------
# Database (Supabase PostgreSQL / local fallback)
# ------------------------------------------------------------------------------
# Target of record is Supabase PostgreSQL with pgvector.
# Supabase Transaction Pooler (recommended for web apps):
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
# Supabase Direct Connection / Session Pooler:
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
# When left empty, Django automatically falls back to local SQLite (.local.sqlite3) for dev.
DATABASE_URL=
DATABASE_CONN_MAX_AGE=0
DATABASE_SSL_REQUIRE=True
DATABASE_DISABLE_SERVER_SIDE_CURSORS=True
ENABLE_PGVECTOR=False

# ------------------------------------------------------------------------------
# Cross-Origin Resource Sharing (CORS) & CSRF Configuration
# ------------------------------------------------------------------------------
# CORS_ALLOWED_ORIGINS: Comma-separated list of browser frontend origins allowed to
# call the API. Must include scheme (http:// or https://), host, and optional port.
# Wildcards (*) and trailing paths are strictly prohibited in production.
# Development example: http://localhost:3000
# Production example:  https://complywise.vercel.app,https://app.complywise.in
CORS_ALLOWED_ORIGINS=http://localhost:3000

# CSRF_TRUSTED_ORIGINS: Comma-separated list of trusted origins when required by
# Django CSRF protection (cookie/session authentication and Django Admin).
# In production, if left empty, this automatically inherits from CORS_ALLOWED_ORIGINS.
CSRF_TRUSTED_ORIGINS=

# Set to True ONLY if local frontend testing against a production backend is required:
CORS_ALLOW_LOCALHOST_IN_PRODUCTION=False

# ------------------------------------------------------------------------------
# AI Provider Selection
# ------------------------------------------------------------------------------
# Which provider the assistant/retrieval layer uses, resolved through
# backend/domain/providers/ only. No vendor SDK is imported anywhere in app code.
#
# LLM_PROVIDER:        openai | gemini | grok
# EMBEDDING_PROVIDER:  openai | gemini        (xAI/Grok has no embeddings API)
#
# Providers are optional. Configure Gemini slots and OpenAI for the full fallback chain. A selected
# provider without its key reports "not_configured" in /api/v1/health/ready and
# the assistant degrades to citations-only answers. An unrecognised name is a
# loud configuration error (HTTP 503 PROVIDER_MISCONFIGURED), never a silent
# fallback to another vendor. Changing provider never changes applicability
# outcomes — those are decided by the deterministic rule engine.
LLM_PROVIDER=gemini
EMBEDDING_PROVIDER=gemini

# Keys and model names. Leave unused providers' keys empty.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

GEMINI_API_KEY=
# Healthy slots rotate; failures try the remaining slots, then OpenAI. Backend only.
# Alternatively use GEMINI_API_KEY_1, GEMINI_API_KEY_2, ... (no fixed count).
# Existing GEMINI_API1, GEMINI_API2, ... names are also supported.
GEMINI_API_KEYS=
GEMINI_KEY_COOLDOWN_SECONDS=60
# These defaults are verified against a freshly provisioned AI Studio key
# (gemini-2.5-pro/gemini-2.5-flash and text-embedding-004 are retired for new
# accounts). Any model available to your key may be used.
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# xAI Grok (chat completions only). GROK_API_KEY is the xAI console key —
# do not confuse it with a Groq (groq.com) key, which is a different service
# and is not read by this application.
GROK_API_KEY=
GROK_MODEL=grok-4

# ------------------------------------------------------------------------------
# Ingestion & Scraping Tools
# ------------------------------------------------------------------------------
# Server-side only: used by the (optional) knowledge-acquisition pipeline to
# fetch official sources for review. Never sent to the frontend, never in API
# responses. The product works without it — already-loaded PUBLISHED knowledge
# packs are sufficient for onboarding, evaluation and the dashboard.
SERPAPI_API_KEY=
# Existing SERP_API is also accepted; both are backend-only.
SEARCH_TIMEOUT_SECONDS=20
ACQUISITION_TIMEOUT_SECONDS=30

# ------------------------------------------------------------------------------
# Cloud Storage (Azure Blob Storage)
# ------------------------------------------------------------------------------
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=complywise-documents
DOCUMENT_MAX_UPLOAD_BYTES=20971520

# ------------------------------------------------------------------------------
# Knowledge & Compliance Engine
# ------------------------------------------------------------------------------
# "Due soon" counters on the dashboard/initial-results only include statutory
# dates inside this many days.
UPCOMING_DEADLINE_WINDOW_DAYS=30
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# Compliance Deadline Notifications (Per-User Google Calendar & Email)
# ------------------------------------------------------------------------------
# Google Calendar OAuth 2.0 Credentials (for per-user calendar authorization).
# Users authorize their own Google accounts individually via OAuth.
# Required scopes: https://www.googleapis.com/auth/calendar.events
# Note: GOOGLE_CALENDAR_REFRESH_TOKEN / ACCESS_TOKEN are no longer used for dispatch;
# each user's token is stored securely in their UserGoogleCalendarConnection record.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=

# Email Dispatch Settings (SMTP or console)
# In development/test, defaults to console backend:
#   DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# In production, configure SMTP:
DJANGO_EMAIL_BACKEND=
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=compliance-alerts@complywise.in

# ------------------------------------------------------------------------------
# Frontend Settings
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000/api/v1

# Google sign-in. Keep client secret only on the backend.
GOOGLE_AUTH_CLIENT_ID=
GOOGLE_AUTH_CLIENT_SECRET=
GOOGLE_AUTH_REDIRECT_URI=http://127.0.0.1:8000/api/v1/auth/google/callback
GOOGLE_AUTH_FRONTEND_CALLBACK_URL=http://localhost:3000/auth/google/callback

# DEMO ONLY: enabling autofill intentionally reveals these credentials on click.
# Must belong to an existing active COMPLIANCE_OFFICER with no staff/superuser access.
# Never use a production/private account password. Disabled by default.
DEMO_REVIEWER_AUTOFILL_ENABLED=False
# Explicit opt-in only when the account owner designates an existing admin as public demo access.
DEMO_REVIEWER_ALLOW_PRIVILEGED_ACCOUNT=False
DEMO_REVIEWER_EMAIL=
DEMO_REVIEWER_PASSWORD=


# Existing deployed retrieval service, backend only. Search uses /retrieval/search.
COMPLIANCERAG_URL=
COMPLIANCERAG_TIMEOUT_SECONDS=8

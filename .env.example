# ==============================================================================
# ComplyWise Environment Configuration Template
# ==============================================================================
# Copy this file to .env and adjust values for your local or cloud environment.
# Never commit .env with real secrets to version control.

# ------------------------------------------------------------------------------
# Core Django Settings
# ------------------------------------------------------------------------------
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ENABLE_DJANGO_ADMIN=True
COMPLYWISE_VERSION=0.1.0-foundation

# ------------------------------------------------------------------------------
# Database (Supabase PostgreSQL / local fallback)
# ------------------------------------------------------------------------------
# Target of record is Supabase PostgreSQL with pgvector.
# Supabase Transaction Pooler (recommended for web apps):
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
# Supabase Direct Connection / Session Pooler:
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
# When left empty, Django automatically falls back to local SQLite (.local.sqlite3) for dev.
DATABASE_URL=
DATABASE_CONN_MAX_AGE=0
DATABASE_SSL_REQUIRE=True
DATABASE_DISABLE_SERVER_SIDE_CURSORS=True
ENABLE_PGVECTOR=False

# ------------------------------------------------------------------------------
# CORS Configuration
# ------------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# AI Provider Selection
# ------------------------------------------------------------------------------
# Which provider the assistant/retrieval layer uses, resolved through
# backend/domain/providers/ only. No vendor SDK is imported anywhere in app code.
#
# LLM_PROVIDER:        openai | gemini | grok
# EMBEDDING_PROVIDER:  openai | gemini        (xAI/Grok has no embeddings API)
#
# Every provider is optional: configure only the one you select. A selected
# provider without its key reports "not_configured" in /api/v1/health/ready and
# the assistant degrades to citations-only answers. An unrecognised name is a
# loud configuration error (HTTP 503 PROVIDER_MISCONFIGURED), never a silent
# fallback to another vendor. Changing provider never changes applicability
# outcomes — those are decided by the deterministic rule engine.
LLM_PROVIDER=gemini
EMBEDDING_PROVIDER=gemini

# Keys and model names. Leave unused providers' keys empty.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

GEMINI_API_KEY=
# These defaults are verified against a freshly provisioned AI Studio key
# (gemini-2.5-pro/gemini-2.5-flash and text-embedding-004 are retired for new
# accounts). Any model available to your key may be used.
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# xAI Grok (chat completions only). GROK_API_KEY is the xAI console key —
# do not confuse it with a Groq (groq.com) key, which is a different service
# and is not read by this application.
GROK_API_KEY=
GROK_MODEL=grok-4

# ------------------------------------------------------------------------------
# Ingestion & Scraping Tools
# ------------------------------------------------------------------------------
# Server-side only: used by the (optional) knowledge-acquisition pipeline to
# fetch official sources for review. Never sent to the frontend, never in API
# responses. The product works without it — already-loaded PUBLISHED knowledge
# packs are sufficient for onboarding, evaluation and the dashboard.
FIRECRAWL_API_KEY=

# ------------------------------------------------------------------------------
# Cloud Storage (Azure Blob Storage)
# ------------------------------------------------------------------------------
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=complywise-documents
DOCUMENT_MAX_UPLOAD_BYTES=20971520

# ------------------------------------------------------------------------------
# Knowledge & Compliance Engine
# ------------------------------------------------------------------------------
# "Due soon" counters on the dashboard/initial-results only include statutory
# dates inside this many days.
UPCOMING_DEADLINE_WINDOW_DAYS=30
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# Frontend Settings
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000/api/v1

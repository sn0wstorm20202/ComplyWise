# ComplyWise Frontend Environment Template
# Copy this file to .env.local for local development

# Public API Base URL accessed by client browser components
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000/api/v1

# Internal Backend URL used by Next.js rewrites (see next.config.ts)
BACKEND_INTERNAL_URL=http://127.0.0.1:8000

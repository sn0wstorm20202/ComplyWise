# ComplyWise Mobile - Environment Configuration Template
# Copy this file to .env.local for local overrides.
#
# SECURITY WARNING:
# Anything prefixed with EXPO_PUBLIC_ is bundled into the client APK/AAB
# and can be read by end users. Never place secret credentials here!

# Target Environment: development | preview | production
EXPO_PUBLIC_ENV=development

# API Base URL:
# - Android Emulator (defaults automatically): http://10.0.2.2:8000/api/v1
# - Physical Android Device: http://<YOUR_LOCAL_LAN_IP>:8000/api/v1
# - Cloud Staging / Preview: https://preview.complywise.in/api/v1
# - Cloud Production: https://api.complywise.in/api/v1
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8000/api/v1
